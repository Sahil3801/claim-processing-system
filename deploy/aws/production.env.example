# Copy to .env.production, replace every required value, and chmod 600.
APP_DOMAIN=api.example.com
APP_IMAGE=claims-processing-api:production

# Use the exact private RDS endpoint. verify-full checks both the CA and hostname.
DB_JDBC_URL=jdbc:postgresql://claims-db.xxxxxxxxxxxx.region.rds.amazonaws.com:5432/claims_processing?sslmode=verify-full&sslrootcert=/run/certs/rds-global-bundle.pem
DB_USERNAME=claims_app
DB_PASSWORD=replace-with-a-long-url-safe-database-password
DB_POOL_MAX_SIZE=8

REDIS_PASSWORD=replace-with-a-long-url-safe-redis-password
JWT_SECRET=replace-with-at-least-32-random-url-safe-characters
JWT_ISSUER=claims-processing-api
JWT_EXPIRATION_MS=900000

# Generate once with: openssl rand -base64 16 | tr -d '=+/' | head -c 22
KAFKA_CLUSTER_ID=replace-with-a-22-character-cluster-id
KAFKA_LOG_RETENTION_HOURS=24

# Optional outbound mail. Leave blank to avoid storing unused credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true

# Suitable starting limits for a 2 GiB burstable EC2 instance.
APP_MEMORY_LIMIT=640m
APP_CPU_LIMIT=0.75
REDIS_MEMORY_LIMIT=128m
REDIS_CPU_LIMIT=0.20
KAFKA_MEMORY_LIMIT=640m
KAFKA_CPU_LIMIT=0.70
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m
PROXY_MEMORY_LIMIT=96m
PROXY_CPU_LIMIT=0.20
