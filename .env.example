# Copy this file to .env before running Docker Compose. Never commit real secrets.
POSTGRES_DB=claims_processing
POSTGRES_USER=claims_app
POSTGRES_PASSWORD=replace-with-a-long-database-password

REDIS_PASSWORD=replace-with-a-long-redis-password

# Must contain at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters-for-local-use
JWT_ISSUER=claims-processing-api
JWT_EXPIRATION_MS=900000

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080

# Optional outbound email configuration.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true

# Optional resource-limit overrides.
APP_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=384m
REDIS_MEMORY_LIMIT=128m
KAFKA_MEMORY_LIMIT=640m
